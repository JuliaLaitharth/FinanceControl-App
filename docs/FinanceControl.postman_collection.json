    {
      "name": "OAuth (Alexa Account Linking)",
      "item": [
        {
          "name": "Authorize — Página HTML",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/oauth/authorize?client_id={{alexaClientId}}&redirect_uri={{alexaRedirectUri}}&state=STATE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth",
                "authorize"
              ],
              "query": [
                {
                  "key": "client_id",
                  "value": "{{alexaClientId}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{alexaRedirectUri}}",
                  "description": "Precisa estar em ALEXA_REDIRECT_URIS"
                },
                {
                  "key": "state",
                  "value": "STATE"
                }
              ]
            }
          }
        },
        {
          "name": "Authorize — POST (login + gerar code)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/oauth/authorize",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"julia@exemplo.com\",\n  \"senha\": \"Senha@123\",\n  \"redirectUri\": \"{{alexaRedirectUri}}\",\n  \"state\": \"STATE\"\n}"
            }
          }
        },
        {
          "name": "Token — Trocar code",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/oauth/token",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "code",
                  "value": "CODE_DO_AUTHORIZE"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{alexaRedirectUri}}"
                }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{alexaClientId}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{alexaClientSecret}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Token — Refresh",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/oauth/token",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "refresh_token",
                  "value": "REFRESH_TOKEN_ALEXA"
                }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{alexaClientId}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{alexaClientSecret}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
