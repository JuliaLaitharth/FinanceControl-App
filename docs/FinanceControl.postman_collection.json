        {
          "name": "Pluggy Webhook (simulado)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/webhooks/pluggy",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-webhook-secret",
                "value": "{{webhookSecret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"item/updated\",\n  \"itemId\": \"PLUGGY_ITEM_ID\"\n}"
            },
            "description": "O Pluggy não assina os eventos de item: a autenticação é o header x-webhook-secret (igual a PLUGGY_WEBHOOK_SECRET). Sem ele, ou com outro valor, a resposta é 401."
          }
        }
      ]
    }
  ]
}
