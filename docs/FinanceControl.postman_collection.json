    {
      "name": "Auth",
      "item": [
        {
          "name": "Cadastro",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Julia Teste\",\n  \"email\": \"julia@exemplo.com\",\n  \"senha\": \"Senha@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', d.accessToken);",
                  "pm.collectionVariables.set('refreshToken', d.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
