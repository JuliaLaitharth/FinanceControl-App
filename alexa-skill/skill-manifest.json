{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "pt-BR": {
          "name": "FinanceControl",
          "summary": "Consulte saldo e gastos via Alexa.",
          "description": "Skill para o aplicativo FinanceControl com Open Finance. Consulte saldo consolidado, gastos por categoria e receba alertas de transações.",
          "examplePhrases": [
            "Alexa, abre controle financeiro",
            "Alexa, pergunta pro controle financeiro qual é meu saldo",
            "Alexa, pergunta pro controle financeiro quanto gastei esse mês"
          ],
          "keywords": [
            "finanças",
            "saldo",
            "gastos",
            "open finance",
            "banco"
          ]
        }
      },
      "isAvailableWorldwide": false,
      "testingInstructions": "Vincule a conta antes de usar. É necessário ter cadastro no app FinanceControl.",
      "category": "FINANCE",
      "distributionCountries": [
        "BR"
      ]
    },
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "arn:aws:lambda:us-east-1:SEU_ACCOUNT_ID:function:FinanceControlSkill"
        }
      }
    },
    "permissions": [
      {
        "name": "alexa::devices:all:notifications:write"
      }
    ],
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "usesPersonalInfo": false,
      "isChildDirected": false,
      "isExportCompliant": true,
      "containsAds": false,
      "privacyPolicyUrl": "https://SEU-DOMINIO/privacidade"
    },
    "accountLinking": {
      "accountLinkingType": "AUTH_CODE",
      "authorizationUrl": "https://SUA-API/oauth/authorize",
      "accessTokenUrl": "https://SUA-API/oauth/token",
      "clientId": "financecontrol-alexa",
      "scopes": [
        "profile"
      ],
      "accessTokenScheme": "HTTP_BASIC",
      "skipOnEnablement": false
    },
    "events": {
      "publications": [
        {
          "eventName": "AMAZON.MessageAlert.Activated"
        }
      ]
    }
  }
}
