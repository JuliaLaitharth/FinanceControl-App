# ── Banco de dados ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://finuser:finpass@localhost:5432/assistente"

# ── JWT ─────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 64
JWT_SECRET="troque-por-um-segredo-de-no-minimo-64-caracteres-aleatorios-aqui"

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT="6379"
# Em produção (Railway/Render/Upstash) use a URL do serviço; ela tem prioridade sobre as duas acima.
# REDIS_URL="redis://default:senha@host:6379"   (rediss:// para TLS)

# ── Pluggy ───────────────────────────────────────────────────────────────────
# Obtenha em https://dashboard.pluggy.ai  (use o sandbox para desenvolvimento)
PLUGGY_CLIENT_ID="seu-client-id-pluggy"
PLUGGY_CLIENT_SECRET="seu-client-secret-pluggy"
# Valor exigido no header x-webhook-secret dos webhooks do Pluggy (o Pluggy não assina os
# eventos de item: o webhook é cadastrado com este header). Gere com: openssl rand -hex 32
PLUGGY_WEBHOOK_SECRET="seu-webhook-secret-pluggy"

# ── Criptografia em repouso (AES-256-GCM) ────────────────────────────────────
# Gere com: openssl rand -hex 32  (deve ter exatamente 64 hex chars = 32 bytes)
ENCRYPTION_KEY="troque-por-32-bytes-em-hex-64-caracteres"

# ── Firebase Cloud Messaging (opcional) ──────────────────────────────────────
# JSON da conta de serviço do Firebase, puro ou em base64. Sem ele, o push fica desligado.
FCM_SERVER_KEY=""

# ── Alexa Skill ──────────────────────────────────────────────────────────────
# Alertas por voz (opcional): credenciais da skill, obtidas com
#   ask smapi get-skill-credentials -s SKILL_ID   (ver docs/INTEGRACOES.md)
ALEXA_CLIENT_ID=""
ALEXA_CLIENT_SECRET=""

# Account Linking da Alexa (OAuth). Sem estes valores nenhuma vinculação é aceita.
# Client ID/secret: você inventa e cola os MESMOS valores no console da Alexa.
ALEXA_OAUTH_CLIENT_ID="financecontrol-alexa"
ALEXA_OAUTH_CLIENT_SECRET="gere-com-openssl-rand-hex-32"
# Redirect URLs que o console da Alexa mostra (Account Linking), separadas por vírgula.
ALEXA_REDIRECT_URIS="https://pitangui.amazon.com/api/skill/link/XXXXXXXXXXXXXX,https://layla.amazon.com/api/skill/link/XXXXXXXXXXXXXX,https://alexa.amazon.co.jp/api/skill/link/XXXXXXXXXXXXXX"
# "development" enquanto a skill não foi publicada; "live" depois.
ALEXA_SKILL_STAGE="development"

# ── E-mail (SMTP) — AINDA NÃO IMPLEMENTADO: estas variáveis não são lidas ───────
# O MailService só registra o token de recuperação de senha no log.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="no-reply@example.com"
SMTP_PASS="senha-smtp"
SMTP_FROM="FinanceControl <no-reply@example.com>"

# ── App ───────────────────────────────────────────────────────────────────────
PORT="3000"
NODE_ENV="development"
# Espera pelo banco na subida do container (scripts/start.sh); valores padrão abaixo
# MIGRATE_MAX_TENTATIVAS="24"
# MIGRATE_ESPERA_SEGUNDOS="5"
